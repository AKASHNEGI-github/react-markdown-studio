# Copy to .env (or set these in your hosting dashboard / CI) before building.

# Where the site will live, WITH a trailing slash. Used for canonical + social-card URLs and sitemap.xml.
VITE_SITE_URL=https://akashnegi-github.github.io/react-markdown-studio/

# Live "site visits" counter. Create a free site at https://www.goatcounter.com, then enable
# Settings -> "Allow adding visitor counts on your website". Put the site code here (xyz in xyz.goatcounter.com).
# Leave empty to hide the counter (it then shows an em dash instead of a made-up number).
VITE_GOATCOUNTER_CODE=
