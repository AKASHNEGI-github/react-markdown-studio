{
  "name": "react-markdown-studio",
  "version": "1.0.0",
  "description": "Zero-dependency React Markdown editor with live preview, GitHub-style alerts, code tabs, tables and task lists. TypeScript, SSR-safe, XSS-hardened.",
  "keywords": [
    "react-markdown-editor",
    "markdown-editor",
    "react-markdown-renderer",
    "markdown-renderer",
    "markdown-preview",
    "markdown-viewer",
    "markdown-parser",
    "markdown-to-html",
    "markdown",
    "react",
    "react-component",
    "editor",
    "live-preview",
    "split-view",
    "gfm",
    "github-flavored-markdown",
    "github-alerts",
    "admonitions",
    "callouts",
    "code-group",
    "syntax-highlighting",
    "task-list",
    "table-editor",
    "typescript",
    "ssr",
    "nextjs",
    "zero-dependency",
    "lightweight",
    "xss-safe",
    "accessible",
    "dark-mode",
    "themeable"
  ],
  "license": "MIT",
  "author": {
    "name": "Akash Negi",
    "url": "https://github.com/AKASHNEGI-github"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKASHNEGI-github/react-markdown-studio.git"
  },
  "bugs": {
    "url": "https://github.com/AKASHNEGI-github/react-markdown-studio/issues"
  },
  "homepage": "https://akashnegi-github.github.io/react-markdown-studio/",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core/index.d.ts",
        "default": "./dist/esm/core/index.js"
      },
      "require": {
        "types": "./dist/cjs/core/index.d.ts",
        "default": "./dist/cjs/core/index.js"
      }
    },
    "./editor": {
      "import": {
        "types": "./dist/esm/editor/index.d.ts",
        "default": "./dist/esm/editor/index.js"
      },
      "require": {
        "types": "./dist/cjs/editor/index.d.ts",
        "default": "./dist/cjs/editor/index.js"
      }
    },
    "./highlighter": {
      "import": {
        "types": "./dist/esm/highlighter/index.d.ts",
        "default": "./dist/esm/highlighter/index.js"
      },
      "require": {
        "types": "./dist/cjs/highlighter/index.d.ts",
        "default": "./dist/cjs/highlighter/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/API.md",
    "docs/SYNTAX.md",
    "docs/MIGRATION.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config website/vite.config.ts",
    "build": "npm run build:lib && npm run build:website",
    "build:demo": "vite build",
    "build:lib": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/fix-dist-extensions.mjs && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p website",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib && npm run lint:package && npm run check:size",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "lint:package": "publint --strict && attw --pack . --profile node16 --exclude-entrypoints ./styles.css ./package.json",
    "check:size": "node scripts/check-size.mjs",
    "prebuild:website": "node website/scripts/gen-facts.mjs",
    "build:website": "vite build --config website/vite.config.ts && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir --config website/vite.config.ts && node website/scripts/postbuild.mjs",
    "preview:website": "vite preview --config website/vite.config.ts",
    "docs:syntax": "vite-node scripts/gen-syntax-docs.ts",
    "docs:check": "vite-node scripts/gen-syntax-docs.ts --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/AKASHNEGI-github"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/esm/core/index.d.ts"
      ],
      "editor": [
        "./dist/esm/editor/index.d.ts"
      ],
      "highlighter": [
        "./dist/esm/highlighter/index.d.ts"
      ]
    }
  }
}
